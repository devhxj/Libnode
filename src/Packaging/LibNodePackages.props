<Project>
  <!-- Only RIDs with a native build, runtime tests and a real NuGet consumer
       belong in the release closure. Other build candidates remain unadvertised. -->
  <ItemGroup>
    <LibNodeRuntimePackage Include="linux-x64" />
    <LibNodeRuntimePackage Include="win-x64" />
    <LibNodeRuntimePackage Include="linux-arm64" />
    <LibNodeRuntimePackage Include="win-arm64" />
  </ItemGroup>
</Project>
