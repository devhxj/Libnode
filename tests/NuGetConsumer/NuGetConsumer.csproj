<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <CETCompat>false</CETCompat>
    <CandidateNativePackageId Condition="'$(CandidateNativePackageId)' == ''">Jazor.LibNode.linux-x64</CandidateNativePackageId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.JavaScript.NodeApi" Version="$(NodeApiVersion)" />
    <PackageReference Include="$(CandidateNativePackageId)" Version="$(CandidatePackageVersion)" />
  </ItemGroup>
</Project>
