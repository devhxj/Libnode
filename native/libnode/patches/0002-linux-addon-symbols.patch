--- a/src/node_embedding_api.cc
+++ b/src/node_embedding_api.cc
@@ -17,6 +17,7 @@
 #if defined(__APPLE__)
 #include <sys/select.h>
 #elif defined(__linux)
+#include <dlfcn.h>
 #include <sys/epoll.h>
 #endif
 
@@ -245,6 +246,9 @@
   bool v8_is_initialized_{false};
   bool v8_is_uninitialized_{false};
   NodePlatformFlags flags_;
+#if defined(__linux)
+  void* addon_library_handle_{nullptr};
+#endif
   std::vector<std::string> args_;
   struct {
     bool flags : 1;
@@ -638,6 +642,9 @@
     v8::V8::DisposePlatform();
     node::TearDownOncePerProcess();
   }
+#if defined(__linux)
+  if (addon_library_handle_ != nullptr) dlclose(addon_library_handle_);
